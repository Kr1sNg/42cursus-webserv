std::vector<std::string> buildCgiEnv(const std::string& method,
                                     const std::string& query,
                                     const std::string& contentLength,
                                     const std::string& contentType,
                                     const std::string& scriptPath) {
    std::vector<std::string> env;
    env.push_back("REQUEST_METHOD=" + method);
    env.push_back("QUERY_STRING=" + query);
    env.push_back("CONTENT_LENGTH=" + contentLength);
    env.push_back("CONTENT_TYPE=" + contentType);
    env.push_back("SCRIPT_FILENAME=" + scriptPath);
    env.push_back("GATEWAY_INTERFACE=CGI/1.1");
    env.push_back("SERVER_PROTOCOL=HTTP/1.1");
    env.push_back("REDIRECT_STATUS=200"); // Required for PHP sometimes
    return env;
}

std::string executeCgiScript(const std::string& scriptPath,
                             const std::string& method,
                             const std::string& query,
                             const std::string& body = "") {
    int inPipe[2], outPipe[2];
    pipe(inPipe);   // Parent writes to CGI stdin
    pipe(outPipe);  // CGI writes to parent

    pid_t pid = fork();

    if (pid == 0) {
        // CHILD
        dup2(inPipe[0], STDIN_FILENO);
        dup2(outPipe[1], STDOUT_FILENO);
        close(inPipe[1]);
        close(outPipe[0]);

        std::vector<std::string> env = buildCgiEnv(method, query,
                                                   std::to_string(body.size()), "text/plain", scriptPath);
        char** envp = convertEnvToCArray(env);

        char* argv[] = {const_cast<char*>(scriptPath.c_str()), nullptr};
        execve(scriptPath.c_str(), argv, envp);
        perror("execve failed");
        exit(1);
    } else {
        // PARENT
        close(inPipe[0]);
        close(outPipe[1]);

        // Send POST body to CGI stdin if needed
        if (method == "POST") {
            write(inPipe[1], body.c_str(), body.size());
        }
        close(inPipe[1]);

        // Read CGI output
        char buffer[4096];
        std::string output;
        ssize_t bytesRead;
        while ((bytesRead = read(outPipe[0], buffer, sizeof(buffer))) > 0) {
            output.append(buffer, bytesRead);
        }
        close(outPipe[0]);

        waitpid(pid, nullptr, 0); // Wait for child
        return output;
    }
}
